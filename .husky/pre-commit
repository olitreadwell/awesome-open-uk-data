#!/usr/bin/env bash
# Pre-commit fast lane: lint, typecheck, data-focused tests.
# Sequential on purpose: parallel npm tasks made vitest fork workers time
# out on this hardware. The full suite (coverage, e2e, smoke) runs in CI.
set -e

echo "=== Pre-commit fast lane ==="

npm run lint --if-present
npm run typecheck --if-present
npm run test:fast --if-present

echo "All checks passed."
