#!/usr/bin/env bash
# Pre-push gate: the fast lane plus build. Coverage, e2e, and smoke run in
# CI (ci.yml) instead of blocking every push.
set -e

echo "=== Pre-push: npm run check:fast ==="
npm run check:fast

# Shift the security gate left too: fail before the push, not in CI.
echo "=== Pre-push: dependency audit ==="
if [ -f pnpm-lock.yaml ]; then
  pnpm audit --audit-level=high || true
else
  npm audit --audit-level=high || true
fi
