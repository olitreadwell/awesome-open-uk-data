#!/usr/bin/env bash
# Pre-push gate: fast lane plus build. Coverage, e2e, and smoke run in CI
# (ci.yml); dependency audit is advisory here and gated by security.yml +
# renovate, so an advisory never bricks the loop lane mid-flight.
set -e

echo "=== Pre-push: npm run check:fast ==="
npm run check:fast

echo "=== Pre-push: dependency advisory ==="
pnpm audit --audit-level=high || echo "audit found advisories (non-blocking; see .github/workflows/security.yml)"
